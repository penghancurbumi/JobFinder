GEMINI_API_KEY=your-gemini-api-key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PORT=3000

# Hari karantina job yang link-nya sudah not_found sebelum dihapus permanen
# (default 2). Selama karantina job disembunyikan dari daftar.
LINK_DEAD_GRACE_DAYS=2

# Interval scheduler otomatis (jam)
AUTO_SCRAPE_INTERVAL_HOURS=3
AUTO_LINK_CHECK_HOURS=6
